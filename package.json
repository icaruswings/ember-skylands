{
  "name": "ember-skylands",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/export-models.mjs",
    "test": "node --test tests/*.test.js",
    "dev": "python -m http.server 4173 --directory dist",
    "check": "node tests/check-source.mjs",
    "format": "prettier --write dist/engine dist/game dist/main.js dist/index.html dist/style.css tests/*.test.js docs/*.md README.md"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
